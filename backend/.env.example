# Copy this file to .env and fill in the values. Never commit .env.
# Dolt (MySQL-compatible) SQL server started with: dolt sql-server
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=business_service_db
# Set DB_SSL=true when connecting to cloud MySQL providers (Aiven, TiDB, etc.)
DB_SSL=false
# Aiven MySQL CA Certificate: provide either the inline certificate string or path to ca.pem file
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_CA_PATH=./ca.pem
API_PORT=4000
# Optional CORS origin (leave empty for same-origin unified deployment or '*' for all)
CORS_ORIGIN=
# Secret used to sign login tokens. Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
